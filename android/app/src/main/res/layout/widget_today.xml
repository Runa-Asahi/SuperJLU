<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="SuperJLU" android:textSize="12sp" android:textColor="@color/widget_sub" android:maxLines="1" />
    <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="课表" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widget_accent" android:maxLines="1" />
    <TextView android:id="@+id/w_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="打开 SuperJLU 同步课表" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/widget_fg" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="@color/widget_sub" android:maxLines="3" android:ellipsize="end" />
</LinearLayout>
